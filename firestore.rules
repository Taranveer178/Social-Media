rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin';
    }

    function activeUser() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'suspended');
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user';
      allow update: if isAdmin()
        || (activeUser()
          && request.auth.uid == userId
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
            || (request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
              && request.resource.data.get('status', 'active') == resource.data.get('status', 'active'))));
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update: if isAdmin()
        || (activeUser() && request.auth.uid == userId)
        || (activeUser() && resource.data.get('isSeed', false) == true);
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if activeUser() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if activeUser()
        && request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if activeUser()
        && (resource.data.participants.hasAny([request.auth.uid])
          || request.resource.data.participants.hasAny([request.auth.uid]));
      allow delete: if isAdmin()
        || (activeUser() && resource.data.participants.hasAny([request.auth.uid]));

      match /messages/{messageId} {
        function isChatMember() {
          return activeUser()
            && get(/databases/$(database)/documents/chats/$(chatId)).data.participants
              .hasAny([request.auth.uid]);
        }
        allow read: if isChatMember();
        allow create: if isChatMember();
        allow update: if isChatMember();
        allow delete: if isChatMember() && resource.data.senderId == request.auth.uid;
      }
    }

    match /stories/{storyId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update: if activeUser();
      allow delete: if isAdmin()
        || (activeUser() && resource.data.userId == request.auth.uid);
    }

    match /circles/{circleId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update: if activeUser();
      allow delete: if isAdmin()
        || (activeUser() && resource.data.creatorId == request.auth.uid);
    }

    match /moments/{momentId} {
      allow read: if activeUser();
      allow create: if activeUser();
      allow update: if activeUser();
      allow delete: if isAdmin()
        || (activeUser() && resource.data.authorId == request.auth.uid);
    }

    match /connections/{connectionId} {
      allow read: if activeUser()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
          || isAdmin());
      allow create: if activeUser()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if activeUser()
        && (resource.data.recipientId == request.auth.uid
          || resource.data.senderId == request.auth.uid
          || isAdmin());
      allow delete: if activeUser()
        && (resource.data.recipientId == request.auth.uid
          || resource.data.senderId == request.auth.uid
          || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if activeUser() && resource.data.recipientId == request.auth.uid;
      allow create: if activeUser();
      allow update, delete: if activeUser() && resource.data.recipientId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
